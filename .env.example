# =============================================================================
# LLM provider. Pick ONE of the three options below.
# =============================================================================

# --- Option A (default, FREE): OpenRouter ---------------------------------------
# Get a free key at https://openrouter.ai/keys (no credit card needed for :free models)
LLM_PROVIDER=openrouter
LLM_API_KEY=your-openrouter-key
# Optional overrides (defaults shown; picked from the measured benchmark in docs/benchmarks/):
# LLM_MODEL=baidu/ernie-5.5-flash-preview:free
# LLM_FALLBACK_MODEL=nvidia/nemotron-3.5-super-vl:free,openrouter/free

# --- Option B (FREE tier): Google Gemini via its OpenAI-compatible endpoint ------
# Get a key at https://aistudio.google.com/apikey
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your-gemini-key
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_FALLBACK_MODEL=none

# --- Option C (paid, recommended for production): Anthropic Claude ---------------
# Get a key at https://platform.claude.com/settings/keys
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-anthropic-key
# LLM_MODEL=claude-haiku-5-5
# LLM_FALLBACK_MODEL=claude-sonnet-5-5
# LLM_EFFORT=low

# =============================================================================
# Optional tuning (defaults shown)
# =============================================================================
# LLM_MAX_TOKENS=             # default: 16000 for Claude, 32000 for OpenAI-compatible
# LLM_TIMEOUT_SECONDS=120
# FETCH_TIMEOUT_SECONDS=12
# FETCH_MAX_SUBPAGES=4
# CONTENT_CHAR_BUDGET=30000      # ~7.5K tokens of cleaned text sent to the LLM
# CACHE_TTL_SECONDS=21600        # 6h result cache per URL
# RATE_LIMIT_PER_MINUTE=10       # per client IP; 0 disables
# VERIFY_COMPETITOR_WEBSITES=true
# LOG_LEVEL=INFO
